#################################################
# iStoreOS 25.12 - Qihoo 360T7
# Target: MediaTek Filogic / MT7981
#################################################

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y


#################################################
# 基础 LuCI
#################################################

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y

CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_dropbear=y


#################################################
# 中文语言
#################################################

CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y


#################################################
# iStoreOS 原生组件
#################################################

CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y

CONFIG_PACKAGE_luci-i18n-store-zh-cn=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y


#################################################
# Argon 主题
#################################################

CONFIG_PACKAGE_luci-theme-argon=y


#################################################
# 网络基础工具
#################################################

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-tcp-bbr=y


#################################################
# PassWall
#
# PassWall 本体及依赖由 diy-part2.sh
# 在 feeds 完成后加入。
#################################################

CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_passwall_INCLUDE_Haproxy=y


#################################################
# MosDNS
#
# mosdns / v2dat / luci-app-mosdns
# 由 diy-part2.sh 使用 v5 feed 加入。
#################################################

CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2dat=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y


#################################################
# Tailscale
#################################################

CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y


#################################################
# 常用诊断工具
#################################################

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_bind-dig=y


#################################################
# SSH / SFTP
#################################################

CONFIG_PACKAGE_openssh-sftp-server=y


#################################################
# 编译辅助
#################################################

# 保证固件可以正常通过 squashfs + UBI 构建
CONFIG_TARGET_ROOTFS_SQUASHFS=y


#################################################
# 不在第一版固件中强制集成 Daed
#
# Daed/BPF/BTF/XDP 属于额外复杂度，
# 稳定版先不强制加入。
#
# 需要 Daed 时再单独做第二版。
#################################################

# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_luci-app-daed is not set
