name: iStoreOS-360T7

on:
  workflow_dispatch:
  push:
    branches:
      - main
  repository_dispatch:
    types: [source-code-update]

env:
  REPO_URL: https://github.com/istoreos/istoreos
  REPO_BRANCH: istoreos-25.12

  FEEDS_CONF: feeds.conf.default
  CONFIG_FILE: .config
  DIY_P1_SH: diy-part1.sh
  DIY_P2_SH: diy-part2.sh

  TZ: Asia/Shanghai

jobs:
  build:
    name: Build 360T7 Firmware
    runs-on: ubuntu-24.04

    permissions:
      contents: write

    defaults:
      run:
        shell: bash

    steps:

      - name: Checkout
        uses: actions/checkout@v4

      - name: Free Disk Space & Setup Swap
        run: |
          set -euxo pipefail

          sudo rm -rf \
            /usr/share/dotnet \
            /usr/local/lib/android \
            /opt/ghc \
            /opt/hostedtoolcache/CodeQL

          sudo docker image prune -af || true

          sudo swapoff -a || true
          sudo rm -f /swapfile

          sudo fallocate -l 8G /swapfile
          sudo chmod 600 /swapfile
          sudo mkswap /swapfile
          sudo swapon /swapfile

          echo "========== MEMORY =========="
          free -h

          echo "========== DISK =========="
          df -h

      - name: Setup Build Environment
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          set -euxo pipefail

          sudo apt-get update

          sudo apt-get install -y \
            ack \
            asciidoc \
            autoconf \
            automake \
            autopoint \
            binutils \
            bison \
            build-essential \
            bzip2 \
            ccache \
            clang \
            cmake \
            cpio \
            curl \
            device-tree-compiler \
            dwarves \
            flex \
            gawk \
            gcc \
            g++ \
            gettext \
            git \
            gperf \
            help2man \
            intltool \
            lld \
            libclang-dev \
            libelf-dev \
            libfuse-dev \
            libglib2.0-dev \
            libgmp-dev \
            libltdl-dev \
            libmpc-dev \
            libmpfr-dev \
            libncurses-dev \
            libreadline-dev \
            libssl-dev \
            libtool \
            llvm \
            make \
            ninja-build \
            patch \
            pkgconf \
            python3 \
            python3-dev \
            python3-pyelftools \
            python3-setuptools \
            qemu-utils \
            rsync \
            scons \
            squashfs-tools \
            subversion \
            swig \
            texinfo \
            unzip \
            wget \
            xmlto \
            xxd \
            zlib1g-dev

          CLANG_PATH="$(command -v clang || true)"
          LLVM_STRIP_PATH="$(command -v llvm-strip || true)"

          if [ -z "$CLANG_PATH" ] || [ ! -x "$CLANG_PATH" ]; then
            echo "ERROR: clang executable not found."
            exit 1
          fi

          if [ -z "$LLVM_STRIP_PATH" ] || [ ! -x "$LLVM_STRIP_PATH" ]; then
            echo "ERROR: llvm-strip executable not found."
            exit 1
          fi

          CLANG_PATH="$(readlink -f "$CLANG_PATH")"
          LLVM_STRIP_PATH="$(readlink -f "$LLVM_STRIP_PATH")"

          echo "CLANG_PATH=$CLANG_PATH" >> "$GITHUB_ENV"
          echo "LLVM_STRIP_PATH=$LLVM_STRIP_PATH" >> "$GITHUB_ENV"

          sudo ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime

          echo "========== TOOLCHAIN =========="
          "$CLANG_PATH" --version | head -n 1
          "$LLVM_STRIP_PATH" --version | head -n 1
          pahole --version || true
          gcc --version | head -n 1

      - name: Clone Source Code
        run: |
          set -euxo pipefail

          git clone \
            --depth=1 \
            --single-branch \
            --branch="$REPO_BRANCH" \
            "$REPO_URL" \
            openwrt

          cd openwrt
          git log -1 --oneline
          git branch --show-current

      - name: Load Feeds & Update
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE"

          if [ -f "$FEEDS_CONF" ]; then
            cp "$FEEDS_CONF" openwrt/feeds.conf.default
          fi

          cd openwrt

          if [ -f "$GITHUB_WORKSPACE/$DIY_P1_SH" ]; then
            chmod +x "$GITHUB_WORKSPACE/$DIY_P1_SH"
            "$GITHUB_WORKSPACE/$DIY_P1_SH"
          fi

          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Load Config & Run DIY2
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE"

          # 可选：若仍残留 files/，可拷贝；网络配置已不再强制要求
          if [ -d files ]; then
            rm -rf openwrt/files
            cp -a files openwrt/files
          fi

          if [ -f "$CONFIG_FILE" ]; then
            cp "$CONFIG_FILE" openwrt/.config
          else
            echo "ERROR: .config not found."
            exit 1
          fi

          cd openwrt

          chmod +x "$GITHUB_WORKSPACE/$DIY_P2_SH"
          "$GITHUB_WORKSPACE/$DIY_P2_SH"

          echo "========== Running make defconfig =========="
          make defconfig

          echo "========== Target =========="
          grep -E '^CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7(-ubi)?=y' .config

          echo "========== Daed =========="
          grep '^CONFIG_PACKAGE_daed=y' .config
          grep '^CONFIG_PACKAGE_luci-app-daede=y' .config

          echo "========== MosDNS =========="
          grep '^CONFIG_PACKAGE_mosdns=y' .config

          echo "========== Tailscale =========="
          grep '^CONFIG_PACKAGE_tailscale=y' .config
          grep '^CONFIG_PACKAGE_luci-app-tailscale-community=y' .config
          grep '^CONFIG_PACKAGE_kmod-tun=y' .config

          echo "========== WiFi =========="
          grep '^CONFIG_PACKAGE_kmod-mt7915e=y' .config
          grep '^CONFIG_PACKAGE_wpad-basic-mbedtls=y' .config

      - name: Verify Package Tree
        run: |
          set -euxo pipefail
          cd openwrt

          test -f package/daed/Makefile
          test -f package/luci-app-daede/Makefile

          grep -q '^CONFIG_KERNEL_DEBUG_INFO_BTF=y' .config
          if grep -q '^CONFIG_KERNEL_DEBUG_INFO_REDUCED=y' .config; then
            echo "ERROR: reduced kernel debug info disables kernel BTF."
            exit 1
          fi

          if [ -e package/feeds/base/dae ]; then
            echo "ERROR: old feed package/feeds/base/dae still exists."
            exit 1
          fi

          echo "OK: package tree verified."

      - name: Reset Go Build Cache
        run: |
          set -euxo pipefail
          cd openwrt
          rm -rf dl/go-mod-cache tmp/go-build
          mkdir -p dl/go-mod-cache tmp/go-build

      - name: Download Sources
        run: |
          set -euxo pipefail
          cd openwrt
          make download -j"$(nproc)"
          find dl -type f -size -1024c -print -delete || true

      - name: Compile Firmware
        run: |
          set -euxo pipefail
          cd openwrt

          export CCACHE_DIR="$HOME/.ccache"
          export CCACHE_MAXSIZE=2G

          ccache --zero-stats || true

          BUILD_TIMEOUT_MIN=120
          set +e
          timeout --foreground ${BUILD_TIMEOUT_MIN}m make \
            -j"$(nproc)" \
            CLANG="$CLANG_PATH" \
            LLVM_STRIP="$LLVM_STRIP_PATH" \
            BPF_CLANG="$CLANG_PATH" \
            BPF_STRIP="$LLVM_STRIP_PATH"
          BUILD_RC=$?
          set -e

          if [ "$BUILD_RC" -eq 124 ]; then
            echo "ERROR: Full firmware build exceeded ${BUILD_TIMEOUT_MIN} minutes."
            exit 124
          fi

          if [ "$BUILD_RC" -ne 0 ]; then
            echo "ERROR: Top-level OpenWrt build failed with exit code $BUILD_RC."
            exit "$BUILD_RC"
          fi

          ccache --show-stats || true

      - name: Check Firmware
        run: |
          set -euxo pipefail
          cd openwrt
          TARGET_DIR="bin/targets/mediatek/filogic"
          test -d "$TARGET_DIR"
          ls -lah "$TARGET_DIR"

          IMAGE_COUNT="$(
            find "$TARGET_DIR" -maxdepth 1 -type f \
              \( -name '*.itb' -o -name '*.img' -o -name '*.bin' -o -name '*.gz' -o -name '*.tar' \) \
              | wc -l
          )"

          if [ "$IMAGE_COUNT" -eq 0 ]; then
            echo "ERROR: No firmware image found."
            exit 1
          fi

          find "$TARGET_DIR" -maxdepth 1 -type f -name '*360t7*.itb' -printf '%f %s bytes\n' | sort

      - name: Organize Firmware
        run: |
          set -euxo pipefail
          cd openwrt/bin/targets/mediatek/filogic
          rm -rf packages
          echo "FIRMWARE=$PWD" >> "$GITHUB_ENV"
          echo "FILE_DATE=$(date +"%Y%m%d%H%M")" >> "$GITHUB_ENV"
          echo "RELEASE_TAG=iStoreOS-360T7-$(date +"%Y%m%d%H%M")" >> "$GITHUB_ENV"
          ls -lah

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: iStoreOS-360T7-${{ env.FILE_DATE }}
          path: ${{ env.FIRMWARE }}/*
          if-no-files-found: error
          retention-days: 7

      - name: Generate Release Info
        run: |
          set -euxo pipefail
          cat > release.txt <<EOF
          iStoreOS 25.12 - Qihoo 360T7

          Target: MediaTek MT7981 / Filogic
          Device: Qihoo 360T7

          Network (board.d default):
          - LAN: lan1 lan2 lan3 @ 192.168.1.1
          - WAN: wan (DHCP)

          Included:
          - Daed (daede)
          - MosDNS v5
          - Tailscale
          - WiFi mt7915e / MT7976C

          Source: iStoreOS ${REPO_BRANCH}
          Build Date: $(date +"%Y-%m-%d %H:%M:%S")
          EOF
          cat release.txt

      - name: Upload Release
        uses: softprops/action-gh-release@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: ${{ env.RELEASE_TAG }}
          name: iStoreOS 25.12 for 360T7 - ${{ env.FILE_DATE }}
          body_path: release.txt
          files: ${{ env.FIRMWARE }}/*
          fail_on_unmatched_files: true
