#################################################
# Target
#################################################

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_360t7=y

#################################################
# LuCI
#################################################

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y

#################################################
# 中文
#################################################

CONFIG_LUCI_LANG_zh_Hans=y

#################################################
# iStore
#################################################

CONFIG_PACKAGE_luci-app-istore=y

#################################################
# Daed
#################################################

CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y

CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y

CONFIG_PACKAGE_kmod-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

#################################################
# PassWall
#################################################

CONFIG_PACKAGE_luci-app-passwall=y

CONFIG_PACKAGE_passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_passwall_INCLUDE_Xray=y

#################################################
# MosDNS
#################################################

CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2dat=y

CONFIG_PACKAGE_luci-app-mosdns=y

#################################################
# Tailscale
#################################################

CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y

#################################################
# 网络优化
#################################################

CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y

CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y

#################################################
# ttyd
#################################################

CONFIG_PACKAGE_luci-app-ttyd=y

#################################################
# UPnP
#################################################

CONFIG_PACKAGE_luci-app-upnp=y

#################################################
# 工具
#################################################

CONFIG_PACKAGE_openssh-sftp-server=y

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
